{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "materialist-dialectics-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-04-11",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "luxi.blog/api/*",
      "zone_name": "luxi.blog"
    },
    {
      "pattern": "www.luxi.blog/api/*",
      "zone_name": "luxi.blog"
    }
  ],
  // Secrets (set via `wrangler secret put`):
  //   UPSTREAM_URL      — Vercel 函数直连地址，不得提交到代码库
  //   INTERNAL_TOKEN    — 与 Vercel 函数共享的随机密钥，用于层间鉴权
  //   DEEPSEEK_API_KEY  — 仅在 Worker 直连 DeepSeek 时需要（当前架构走 proxy 模式不需要）
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "ALLOWED_ORIGINS": "https://luxi.blog,https://www.luxi.blog,http://localhost:1313,http://127.0.0.1:1313",
    "INPUT_LIMIT": "1600",
    "MAX_HISTORY_MESSAGES": "8",
    "MAX_OUTPUT_TOKENS": "2000",
    "REQUEST_TIMEOUT_MS": "90000"
  }
}
